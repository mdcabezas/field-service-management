# ============================================================================
# FSM — Production environment variables
# Copy to .env.prod and adjust values
# cp .env.prod.example .env.prod
#
# Generar contrasenas con:
#   openssl rand -base64 32
# ============================================================================

# Postgres (USAR CONTRASENAS SEGURAS)
POSTGRES_PASSWORD=<generar_con_openssl_rand_base64_32>

# JWT secret (Go backend)
JWT_SECRET=<generar_con_openssl_rand_base64_32>

# LDAP service password
LDAP_SERVICE_PASSWORD=<generar_con_openssl_rand_base64_32>
