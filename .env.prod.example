# ============================================================================
# FSM — Production environment variables
# Copy to .env.prod and adjust values
# cp .env.prod.example .env.prod
#
# Generar contraseñas con:
#   openssl rand -base64 32
# ============================================================================

# Postgres (USAR CONTRASEÑAS SEGURAS)
POSTGRES_PASSWORD=<generar_con_openssl_rand_base64_32>

# PostgREST DB password (user fsm_api)
FSM_API_PASSWORD=<generar_con_openssl_rand_base64_32>

# JWT secret (shared with Traefik JWT validator and Go backend)
PGRST_JWT_SECRET=<generar_con_openssl_rand_base64_32>

# Authelia (USAR CONTRASEÑAS SEGURAS DE 32+ CARACTERES)
AUTHELIA_SESSION_SECRET=<generar_con_openssl_rand_32_chars>
AUTHELIA_STORAGE_ENCRYPTION_KEY=<generar_con_openssl_rand_32_chars>
AUTHELIA_JWT_SECRET=<generar_con_openssl_rand_32_chars>

# Authelia LDAP
AUTHELIA_LDAP_PASSWORD=<generar_con_openssl_rand_32_chars>

# Authelia URLs (producción)
AUTHELIA_SESSION_DOMAIN=workflows.cl
AUTHELIA_AUTHELIA_URL=https://auth.workflows.cl
AUTHELIA_DEFAULT_REDIRECT=https://app.workflows.cl
