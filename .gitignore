# ============================================================================
# .gitignore — FSM Project
# ============================================================================

# Environment files
.env
.env.prod
.env.local

# Docker volumes
pgdata/
letsencrypt/

# PostgreSQL
*.pid

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Node (Postman scripts)
node_modules/

# Go binaries
*.exe
*.test
*.out
backend/server

# Logs
*.log

# Temporary files
tmp/
*.tmp

# Agent tooling (not source of truth)
.agents/
.claude/
.opencode/
.playwright/
.playwright-cli/
skills-lock.json
ports/

# Test artifacts
test-results/
frontend/test-results/
frontend/playwright-report/
frontend/tsconfig.tsbuildinfo
