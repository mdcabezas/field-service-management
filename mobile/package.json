{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "allowScripts": {
    "@expo/prebuild-config": false,
    "expo-standard-web-crypto": true,
    "expo-camera": true,
    "expo": true,
    "sharp": true
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.12",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.12",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "^57.0.1",
    "expo-standard-web-crypto": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/utils",
      "<rootDir>/stores",
      "<rootDir>/lib",
      "<rootDir>/components"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^\\.\\./lib/database$": "<rootDir>/stores/__mocks__/database.ts",
      "^\\.\\./lib/auth$": "<rootDir>/stores/__mocks__/auth.ts",
      "^\\.\\./lib/outbox$": "<rootDir>/stores/__mocks__/outbox.ts",
      "^\\.\\./lib/sync-engine$": "<rootDir>/stores/__mocks__/sync-engine.ts",
      "^expo-crypto$": "<rootDir>/stores/__mocks__/expo-crypto.ts"
    }
  },
  "private": true
}
