# ============================================================================
# FSM — Environment variables
# Copy to .env and adjust values
# cp .env.example .env
#
# Generate secrets with:
#   openssl rand -base64 32
# ============================================================================

# Postgres
POSTGRES_PASSWORD=<REPLACE_WITH_GENERATED_SECRET>

# JWT secret (Go backend)
JWT_SECRET=<REPLACE_WITH_GENERATED_SECRET>

# LDAP service password
LDAP_SERVICE_PASSWORD=<REPLACE_WITH_GENERATED_SECRET>
