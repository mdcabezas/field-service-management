# ============================================================================
# FSM — Environment variables
# Copy to .env and adjust values
# cp .env.example .env
#
# Generate secrets with:
#   openssl rand -base64 32
# ============================================================================

# Postgres
POSTGRES_PASSWORD=<REPLACE_WITH_GENERATED_SECRET>

# PostgREST DB password (user fsm_api)
FSM_API_PASSWORD=<REPLACE_WITH_GENERATED_SECRET>

# JWT secret (shared with Traefik JWT validator and Go backend)
PGRST_JWT_SECRET=<REPLACE_WITH_GENERATED_SECRET>

# Authelia
AUTHELIA_SESSION_SECRET=<REPLACE_WITH_32_CHARS>
AUTHELIA_STORAGE_ENCRYPTION_KEY=<REPLACE_WITH_32_CHARS>
AUTHELIA_JWT_SECRET=<REPLACE_WITH_32_CHARS>

# Authelia LDAP
AUTHELIA_LDAP_PASSWORD=<REPLACE_WITH_GENERATED_SECRET>
